// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ENTREPRENEUR
  INVESTOR
  MENTOR
  ADMIN
}

enum StartupStage {
  IDEA
  MVP
  EARLY_STAGE
  GROWTH
  SCALING
  ESTABLISHED
}

enum StartupStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum FundingType {
  BOOTSTRAPPED
  ANGEL
  SEED
  SERIES_A
  SERIES_B
  SERIES_C_PLUS
  GRANT
  CROWDFUNDING
}

enum InvestmentInterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  CONNECTION_DECLINED
  NEW_MESSAGE
  INVESTMENT_INTEREST
  INVESTMENT_ACCEPTED
  INVESTMENT_DECLINED
  INVESTMENT_WITHDRAWN
  MENTORSHIP_REQUEST
  MENTORSHIP_ACCEPTED
  MENTORSHIP_DECLINED
  MENTORSHIP_COMPLETED
  STARTUP_PUBLISHED
  ACCOUNT_SUSPENDED
  GENERAL
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportType {
  STARTUP
  USER
  MESSAGE
}

enum AuditAction {
  USER_SUSPENDED
  USER_REACTIVATED
  USER_DELETED
  STARTUP_APPROVED
  STARTUP_SUSPENDED
  STARTUP_RESTORED
  REPORT_RESOLVED
  REPORT_DISMISSED
  INDUSTRY_CREATED
  INDUSTRY_UPDATED
  INDUSTRY_DELETED
  ADMIN_LOGIN
  ROLE_CHANGED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  password            String?
  name                String?
  image               String?
  role                UserRole  @default(ENTREPRENEUR)
  isActive            Boolean   @default(true)
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  verificationTokens  VerificationToken[]

  entrepreneurProfile EntrepreneurProfile?
  investorProfile     InvestorProfile?
  mentorProfile       MentorProfile?

  startups            Startup[]
  savedStartups       SavedStartup[]
  investmentInterests InvestmentInterest[]   @relation("InvestorInterests")

  sentConnections     ConnectionRequest[]    @relation("SentConnections")
  receivedConnections ConnectionRequest[]    @relation("ReceivedConnections")

  conversations       ConversationParticipant[]
  sentMessages        Message[]

  mentorshipsSent     MentorshipRequest[]    @relation("MentorshipSender")
  mentorshipsReceived MentorshipRequest[]    @relation("MentorshipReceiver")

  notifications       Notification[]

  reportsFiled        Report[]               @relation("ReporterReports")
  reportsAgainst      Report[]               @relation("ReportedUserReports")

  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  type       String
  expires    DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EntrepreneurProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?  @db.Text
  phone           String?
  location        String?
  linkedinUrl     String?
  twitterUrl      String?
  websiteUrl      String?
  yearsExperience Int?
  previousStartups Int?    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InvestorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  organization        String?
  designation         String?
  bio                 String?  @db.Text
  phone               String?
  location            String?
  linkedinUrl         String?
  twitterUrl          String?
  websiteUrl          String?
  portfolioUrl        String?
  minInvestmentINR    BigInt?
  maxInvestmentINR    BigInt?
  preferredStages     StartupStage[]
  geographicFocus     String[]
  investmentThesis    String?  @db.Text
  isProfilePublic     Boolean  @default(true)
  showInvestmentRange Boolean  @default(true)
  showContactInfo     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredIndustries InvestorIndustry[]
  investmentInterests InvestmentInterest[]

  @@index([userId])
}

model MentorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  headline        String?
  bio             String?  @db.Text
  phone           String?
  location        String?
  linkedinUrl     String?
  twitterUrl      String?
  websiteUrl      String?
  yearsExperience Int?
  isAvailable     Boolean  @default(true)
  maxMentees      Int?     @default(5)
  mentorshipFocus String?  @db.Text
  isProfilePublic Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertiseAreas    MentorExpertise[]
  supportedIndustries MentorIndustry[]
  mentorshipRequests  MentorshipRequest[]

  @@index([userId])
}

model Industry {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  startups           StartupIndustry[]
  investorIndustries InvestorIndustry[]
  mentorIndustries   MentorIndustry[]

  @@index([slug])
  @@index([isActive])
}

model StartupIndustry {
  startupId  String
  industryId String

  startup  Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([startupId, industryId])
}

model InvestorIndustry {
  investorProfileId String
  industryId        String

  investorProfile InvestorProfile @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  industry        Industry        @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([investorProfileId, industryId])
}

model MentorIndustry {
  mentorProfileId String
  industryId      String

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  industry      Industry      @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([mentorProfileId, industryId])
}

model MentorExpertise {
  id            String @id @default(cuid())
  mentorProfileId String
  expertise     String

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
}

model Startup {
  id                  String        @id @default(cuid())
  userId              String
  name                String
  slug                String        @unique
  tagline             String?
  description         String?       @db.Text
  logoUrl             String?
  coverImageUrl       String?
  websiteUrl          String?
  videoUrl            String?
  location            String?
  stage               StartupStage  @default(IDEA)
  status              StartupStatus @default(DRAFT)
  fundingType         FundingType?
  fundingGoalINR      BigInt?
  fundingRaisedINR    BigInt?
  equityOffered       Decimal?      @db.Decimal(5, 2)
  problemStatement    String?  @db.Text
  solutionDescription String?  @db.Text
  productDescription  String?  @db.Text
  marketOpportunity   String?  @db.Text
  businessModel       String?  @db.Text
  competitiveAdvantage String? @db.Text
  targetCustomers     String?  @db.Text
  useOfFunds          String?  @db.Text
  traction            String?  @db.Text
  monthlyRevenue      BigInt?
  monthlyActiveUsers  Int?
  teamSize            Int?     @default(1)
  publishedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  industries        StartupIndustry[]
  teamMembers       StartupTeamMember[]
  documents         StartupDocument[]
  savedBy           SavedStartup[]
  investmentInterests InvestmentInterest[]
  reports           Report[]

  @@index([userId])
  @@index([status])
  @@index([stage])
  @@index([slug])
}

model StartupTeamMember {
  id         String   @id @default(cuid())
  startupId  String
  name       String
  role       String
  bio        String?  @db.Text
  imageUrl   String?
  linkedinUrl String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
}

model StartupDocument {
  id          String   @id @default(cuid())
  startupId   String
  name        String
  fileUrl     String
  fileType    String
  fileSize    Int
  isPublic    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
}

model SavedStartup {
  userId    String
  startupId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@id([userId, startupId])
  @@index([userId])
}

model InvestmentInterest {
  id              String                   @id @default(cuid())
  investorUserId  String
  investorProfileId String
  startupId       String
  status          InvestmentInterestStatus @default(PENDING)
  message         String?                  @db.Text
  responseMessage String?                  @db.Text
  respondedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  investorUser    User            @relation("InvestorInterests", fields: [investorUserId], references: [id], onDelete: Cascade)
  investorProfile InvestorProfile @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  startup         Startup         @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([investorUserId, startupId])
  @@index([startupId])
  @@index([investorUserId])
  @@index([status])
}

model ConnectionRequest {
  id          String           @id @default(cuid())
  senderId    String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  message     String?          @db.Text
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  isEdited       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model MentorshipRequest {
  id            String          @id @default(cuid())
  senderId      String
  mentorId      String
  mentorProfileId String
  status        MentorshipStatus @default(PENDING)
  goals         String?         @db.Text
  message       String?         @db.Text
  responseMessage String?       @db.Text
  respondedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sender        User          @relation("MentorshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  mentor        User          @relation("MentorshipReceiver", fields: [mentorId], references: [id], onDelete: Cascade)
  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([mentorId])
  @@index([status])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  title     String
  message   String             @db.Text
  linkUrl   String?
  metadata  Json?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reportedUserId String?
  startupId    String?
  type         ReportType
  reason       String
  description  String?      @db.Text
  status       ReportStatus @default(PENDING)
  adminNotes   String?      @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter     User     @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  startup      Startup? @relation(fields: [startupId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reporterId])
}

model AuditLog {
  id          String      @id @default(cuid())
  adminId     String
  action      AuditAction
  targetType  String?
  targetId    String?
  description String      @db.Text
  metadata    Json?
  createdAt   DateTime    @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

# Environment Variables — Idea Market
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ============================================================
# DATABASE (PostgreSQL via Neon, Supabase, Railway, or local)
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ideamarket?schema=public&sslmode=require"

# ============================================================
# AUTH.JS / NEXT-AUTH
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-super-secret-key-here"

# ============================================================
# EMAIL — Resend (https://resend.com)
# ============================================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Idea Market <noreply@yourdomain.com>"

# ============================================================
# FILE STORAGE — Cloudinary (https://cloudinary.com)
# ============================================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="ideamarket-unsigned"

# ============================================================
# APP SETTINGS
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Idea Market"

# ============================================================
# ADMIN SETUP
# ============================================================
ADMIN_SETUP_KEY="your-admin-setup-secret-key"
